# Copy to .env and fill in. No real credentials required — this project
# runs entirely against synthetic data (see docs/DESIGN.md). docker-compose.yml
# reads POSTGRES_USER/POSTGRES_PASSWORD directly from .env for the Postgres container.

ANTHROPIC_API_KEY=

POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

DATABASE_URL=postgresql://temporal:temporal@localhost:5432/app

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
